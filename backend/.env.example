# ==============================================================================
# Sangrahalayamu - Enterprise Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME="Sangrahalayamu"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=True
LOG_LEVEL="INFO"
API_PREFIX="/api"
SECRET_KEY="dev_secret_key_change_in_production"
JWT_SECRET_KEY="dev_jwt_secret_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="sangrahalayamu"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=False

# ------------------------------------------------------------------------------
# Neo4j Settings
# ------------------------------------------------------------------------------
NEO4J_HOST="localhost"
NEO4J_PORT=7687
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30.0
NEO4J_MAX_TRANSACTION_RETRY_TIME=15.0

# ------------------------------------------------------------------------------
# Qdrant Settings
# ------------------------------------------------------------------------------
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="industry_brain"
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE="Cosine"
QDRANT_TIMEOUT=10.0
QDRANT_USE_HTTPS=False

# ------------------------------------------------------------------------------
# AWS Settings
# ------------------------------------------------------------------------------
AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# LLM & Embedding Settings
# ------------------------------------------------------------------------------
DEFAULT_LLM_MODEL="anthropic.claude-3-haiku-20240307-v1:0"
FALLBACK_LLM_MODEL="meta.llama3-8b-instruct-v1:0"
LLM_PROVIDER="bedrock"
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_TOP_K=250
LLM_MAX_TOKENS=1024

DEFAULT_EMBEDDING_MODEL="amazon.titan-embed-text-v2:0"
FALLBACK_EMBEDDING_MODEL="amazon.titan-embed-text-v1"
EMBEDDING_PROVIDER="bedrock"
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# Retrieval Settings
# ------------------------------------------------------------------------------
RETRIEVAL_WEIGHT_SEMANTIC=0.60
RETRIEVAL_WEIGHT_GRAPH=0.25
RETRIEVAL_WEIGHT_METADATA=0.15
TOP_K_VECTOR=10
TOP_K_GRAPH=10
TOP_K_METADATA=10
MIN_SIMILARITY_SCORE=0.50
ENABLE_RERANKING=True
ENABLE_PERMISSION_FILTERING=True
ENABLE_METADATA_FILTERING=True

# ------------------------------------------------------------------------------
# Chunking Settings
# ------------------------------------------------------------------------------
CHUNK_STRATEGY="layout_aware"
MIN_CHUNK_SIZE=200
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=100
PRESERVE_LAYOUT=True
PRESERVE_TABLES=True
PRESERVE_IMAGES=True

# ------------------------------------------------------------------------------
# Document Processing Settings
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
DEFAULT_DOC_CLASSIFICATION="Internal"
PLUGGABLE_DUPLICATE_DETECTION="disabled"
STORAGE_PROVIDER="local"
STORAGE_ROOT="storage"
TEMP_DIRECTORY="storage/tmp"
ALLOW_OVERWRITE=False
ENABLE_CHECKSUM=True

ENABLE_DOCLING=True
ENABLE_OCR=True
OCR_PROVIDER="docling"
OCR_CONFIDENCE_THRESHOLD=0.7
ENABLE_LAYOUT_TREE=True
ENABLE_ENTITY_STAGE=True
ENABLE_RELATIONSHIP_STAGE=True

# ------------------------------------------------------------------------------
# Context & Prompt Settings
# ------------------------------------------------------------------------------
SYSTEM_PROMPT_VERSION="v1.0"
MAX_CONTEXT_DOCUMENTS=5
MAX_CONTEXT_TOKENS=4096
ENABLE_CITATIONS=True
ENABLE_CONFIDENCE_SCORE=True

# ------------------------------------------------------------------------------
# Audit & Notification Settings
# ------------------------------------------------------------------------------
ENABLE_AUDIT_LOGGING=True
ENABLE_USER_HISTORY=True
AUDIT_RETENTION_DAYS=365
HISTORY_RETENTION_DAYS=90
MAX_HISTORY_EVENTS=100

ENABLE_NOTIFICATIONS=True
NOTIFICATION_PROVIDER="in_app"
DEFAULT_NOTIFICATION_CHANNEL="in_app"
NOTIFICATION_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
ENABLE_HEALTH_CHECKS=True
ENABLE_STARTUP_VALIDATION=True
ENABLE_RAG=True
ENABLE_KNOWLEDGE_GRAPH=True
ENABLE_RECOMMENDATIONS=True
ENABLE_TRANSPARENCY=True
ENABLE_PERSONA_ENGINE=False
ENABLE_COMPLIANCE_AGENT=False
ENABLE_RCA_AGENT=False
ENABLE_FAILURE_INTELLIGENCE=False

# ------------------------------------------------------------------------------
# Performance Settings
# ------------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
BEDROCK_RUNTIME_TIMEOUT=60
BEDROCK_MAX_RETRIES=3
BEDROCK_STREAMING=False
