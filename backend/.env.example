# ==============================================================================
# IndustryBrain-AI — Enterprise Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME="Sangrahalayamu"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=True
LOG_LEVEL="INFO"
API_PREFIX="/api/v1"
SECRET_KEY="change_this_to_a_secure_secret_key_in_production"
JWT_SECRET_KEY="change_this_to_a_secure_jwt_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_DB="Unified_Brain"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=False

# ------------------------------------------------------------------------------
# Neo4j Settings
# ------------------------------------------------------------------------------
NEO4J_HOST="neo4j+s://your-instance.databases.neo4j.io"
NEO4J_PORT=7687
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30.0
NEO4J_MAX_TRANSACTION_RETRY_TIME=15.0

# ------------------------------------------------------------------------------
# Qdrant Settings (Cohere 1024-Dimension Vector Sync)
# ------------------------------------------------------------------------------
QDRANT_HOST="your-cluster.qdrant.tech"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY="your_qdrant_api_key_here"
QDRANT_COLLECTION_NAME="Enterprise_Brain"
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE="Cosine"
QDRANT_TIMEOUT=10.0
QDRANT_USE_HTTPS=True

# ------------------------------------------------------------------------------
# AWS Settings (ap-south-1)
# ------------------------------------------------------------------------------
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# ------------------------------------------------------------------------------
# LLM & Embedding Settings (Cohere Exclusive Embeddings)
# ------------------------------------------------------------------------------
DEFAULT_LLM_MODEL="qwen.qwen3-vl-235b-a22b"
FALLBACK_LLM_MODEL="meta.llama3-8b-instruct-v1:0"
LLM_PROVIDER="bedrock"
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_TOP_K=250
LLM_MAX_TOKENS=1200

DEFAULT_EMBEDDING_MODEL="cohere.embed-multilingual-v3"
FALLBACK_EMBEDDING_MODEL="cohere.embed-multilingual-v3"
EMBEDDING_PROVIDER="bedrock"
EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------------------------
# Retrieval Settings
# ------------------------------------------------------------------------------
RETRIEVAL_WEIGHT_SEMANTIC=0.60
RETRIEVAL_WEIGHT_GRAPH=0.25
RETRIEVAL_WEIGHT_METADATA=0.15
TOP_K_VECTOR=10
TOP_K_GRAPH=10
TOP_K_METADATA=10
MIN_SIMILARITY_SCORE=0.50
ENABLE_RERANKING=True
ENABLE_PERMISSION_FILTERING=True
ENABLE_METADATA_FILTERING=True

# ------------------------------------------------------------------------------
# Chunking Settings
# ------------------------------------------------------------------------------
CHUNK_STRATEGY="layout_aware"
MIN_CHUNK_SIZE=200
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=100
PRESERVE_LAYOUT=True
PRESERVE_TABLES=True
PRESERVE_IMAGES=True

# ------------------------------------------------------------------------------
# Document Processing Settings (Low-Memory 8GB RAM Optimization)
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
DEFAULT_DOC_CLASSIFICATION="Internal"
PLUGGABLE_DUPLICATE_DETECTION="disabled"
STORAGE_PROVIDER="local"
STORAGE_ROOT="storage"
TEMP_DIRECTORY="storage/tmp"
ALLOW_OVERWRITE=False
ENABLE_CHECKSUM=True

ENABLE_DOCLING=False
ENABLE_OCR=True
OCR_PROVIDER="tesseract"

# ------------------------------------------------------------------------------
# Feature Toggles
# ------------------------------------------------------------------------------
ENABLE_TRANSPARENCY=True
ENABLE_AUDIT_LOGGING=True
ENABLE_NOTIFICATIONS=True
ENABLE_RECOMMENDATIONS=False
